// https://zellij.dev/documentation/creating-a-layout.html
layout {
  default_tab_template {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    children
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
  }
  tab name="btm"{
    pane stacked=true {
      pane name="Processes" command="btm" expanded=true
    }
  }
  
  tab name="nodpi"{

      pane command="nodpi"{
        args "--autoblacklist"
        // args "--blacklist" "/home/egomode/.config/nodpi/blacklist.txt"
        cwd "/home/egomode/.local/bin/"
      }
  }
}
