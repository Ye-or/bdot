/* {{ scheme.name }} theme for Mintty
 * Scheme Author: {{ scheme.author }}
 * Scheme System: {{ scheme.system }}
 * waybar = { src = "waybar.css", dst = "~/.config/waybar/colors.css" }
 * And then in you waybar 'style.css' file, import it with:
 * @import url("colors.css");
*/

@define-color background #{{ui.global.background.normal.hex}};
@define-color foreground #{{ui.global.foreground.normal.hex}};
@define-color accent #{{ui.global.foreground.normal.hex}};
