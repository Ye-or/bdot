{
  "niri/workspaces": {
    "format": "{index}: {icon}",
    "icon-size": 24,
    "format-icons": {
      "active": "",
      "default": ""
    }
  },
  "niri/submap": {
    "format": "✌️ {}",
    "max-length": 8,
    "tooltip": false
  },
  "niri/window": {
    "format": "{class} - {title}",
    "max-length": 60,
    "ellipsis": "…",
    "expand": false,
    "rewrite": {
      "(.*) — Mozilla Firefox": " $1",
      "Alacritty": "",
      "Telegram(.*)": " $1"
    }
  },
  "niri/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU"
  },
  "custom/menu": {
    "format": "{icon}",
    "format-icons": "",
    "on-click": "wofi --show drun",
    "escape": true,
    "tooltip": false
  },
  "group/hardware": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-power",
      "transition-left-to-right": false
    },
    "modules": [
      "battery",
      "cpu",
      "memory",
      "temperature"
    ]
  },
  "clock": {
    "format": " {:%H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "  {:%Y-%m-%d}"
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": true
  },
  "memory": {
    "format": "{}% "
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-full": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "swap-icon-label": true
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "󰋎",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  "backlight": {
    "device": "intel_backlight",
    "interval": 2,
    "align": 0,
    "rotate": 0,
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": false
  },
  "backlight/slider": {
    "min": 5,
    "max": 100,
    "orientation": "horizontal",
    "device": "intel_backlight"
  },
  "custom/cmus": {
    "format": "{icon}  {}",
    "format-icons": {
      "default": [
        ""
      ]
    },
    "max-length": 45,
    "interval": 1,
    "exec": "cmus-remote -C \"format_print '%F'\"",
    "exec-if": "pgrep cmus",
    "on-click": "cmus-remote -u",
    "on-scroll-up": "cmus-remote --next",
    "on-scroll-down": "cmus-remote --prev",
    "escape": true,
    "tooltip": false
  },
  "network": {
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ipaddr}/{cidr} 󰈀",
    "tooltip-format": "{ifname} via {gwaddr} 󰔣",
    "format-linked": "{ifname} (No IP) 󰌷",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  }
}
