#!/bin/sh
exec 2>&1

[ -r ./conf ] && . ./conf

if [ "${LOGGING_ENABLE}x" = "1x" -a -n "${LOG_LEVEL}" ]; then
  export AWWWD_DEBUG="${LOG_LEVEL}"
fi
echo "$TURNSTILE_ENV_DIR"

if [ -d "$TURNSTILE_ENV_DIR" ]; then
  if [ -f "${TURNSTILE_ENV_DIR}/XDG_RUNTIME_DIR" ]; then
    XDG_RUNTIME_DIR=$(cat "$TURNSTILE_ENV_DIR/XDG_RUNTIME_DIR")
    export XDG_RUNTIME_DIR
    echo "$XDG_RUNTIME_DIR"
  fi

  if [ -f "${TURNSTILE_ENV_DIR}/WAYLAND_DISPLAY" ]; then
    WAYLAND_DISPLAY=$(cat "$TURNSTILE_ENV_DIR/WAYLAND_DISPLAY")
    export WAYLAND_DISPLAY
    echo "$WAYLAND_DISPLAY"
  fi
fi

if [ -z "$WAYLAND_DISPLAY" ]; then
  echo "Ошибка: WAYLAND_DISPLAY не найден. Ожидание запуска Wayland..."
  sleep 3
  #exit 1
fi

exec awww-daemon
