#!/bin/sh
# ~/.config/service/clipcatd/log/run

# Подгружаем переменные из conf (поднимаемся на уровень выше из директории log/)
[ -r ../conf ] && . ../conf

# Создаем директорию для логов, если её нет
mkdir -p "$LOG_DIR"

# svlogd автоматически управляет ротацией логов.
# Флаг -tt добавляет читаемые таймстампы.
exec svlogd -tt "$LOG_DIR"
