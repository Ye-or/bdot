#!/bin/sh
exec 2>&1

if [ -d "$TURNSTILE_ENV_DIR" ]; then
  if [ -f "$TURNSTILE_ENV_DIR/XDG_RUNTIME_DIR" ]; then
    XDG_RUNTIME_DIR=$(cat "$TURNSTILE_ENV_DIR/XDG_RUNTIME_DIR")
  fi
fi

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
SOCKET_DIR="$RUNTIME_DIR/clipcat"
SOCKET_PATH="$SOCKET_DIR/grpc.sock"
USER_ID=$(id -u)
CLIPCAT_HISTORY_DIR="/tmp/clipcat-$USER_ID/clipcatd-history"

if rm -f "$SOCKET_PATH"; then
  echo "rm ${SOCKET_PATH}: OK" 2>&1
else
  echo "rm ${SOCKET_PATH}: ERROR" 2>&1
  exit 1
fi

if mkdir -p "$SOCKET_DIR"; then
  echo "mkdir ${SOCKET_DIR}: OK " 2>&1
else
  echo "mkdir ${SOCKET_DIR}: ERROR" 2>&1
  exit 1
fi

if mkdir -p "$CLIPCAT_HISTORY_DIR"; then
  echo "mkdir ${CLIPCAT_HISTORY_DIR}: OK " 2>&1
else
  echo "mkdir ${CLIPCAT_HISTORY_DIR}: ERROR" 2>&1
  exit 1
fi

exec chpst -e "$TURNSTILE_ENV_DIR" clipcatd \
  --history-file "${CLIPCAT_HISTORY_DIR}" \
  --grpc-host "127.0.0.1" \
  --grpc-port "45045" \
  --grpc-socket-path "${SOCKET_PATH}" \
  --no-daemon --replace
