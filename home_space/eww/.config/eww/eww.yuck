(include "./power/eww.yuck")

;;source: https://github.com/adi1090x/widgets.git

(defpoll current_time :interval "1s"
  "date '+%I:%M:%S %p'")

(defwidget powermenu_layout []
  (box
    :orientation "vertical"
    :class "menu"
    :halign "center"
    :valign "center"

    (label
      :text current_time
      :class "PMtitle")

    (button
      :onclick "systemctl poweroff"
      "Power Off")

    (button
      :onclick "systemctl reboot"
      "Reboot")

    (button
      :onclick "hyprlock"
      "Lock")

    (button
      :onclick "loginctl terminate-user $USER"
      "Log Out")

    (button
      :onclick "eww close powermenu"
      "Cancel")
  )
)

(defwindow powermenu
  :namespace "powermenu"
  :monitor 0
  :stacking "overlay"
  :focusable true
  :exclusive false
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "100%"
    :height "100%"
    :anchor "top left")

  (box
    :class "powermenu"
    :halign "fill"
    :valign "fill"
    (powermenu_layout)
  )
)

(defwidget closer [window]
  (eventbox :onclick "eww close ${window} && eww close ${window}-closer"))
 
(defwindow menu-closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (closer :window "menu"))
